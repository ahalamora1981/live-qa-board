<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Presenter - Q&A Board</title>
  <script src="https://unpkg.com/htmx.org@2.0.4"></script>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 16px; }
    .qr-section { text-align: center; margin-bottom: 24px; }
    .qr-section img { width: 250px; height: 250px; }
    .qr-section p { font-size: 18px; color: #333; }
    .question { border: 1px solid #ccc; border-radius: 8px; padding: 12px; margin-bottom: 8px; display: flex; justify-content: space-between; align-items: flex-start; }
    .question .body { flex: 1; }
    .question p { margin: 0 0 4px 0; }
    .question .meta { font-size: 12px; color: #666; }
    .vote-badge { font-size: 14px; color: #666; white-space: nowrap; margin-right: 12px; }
    .delete-btn { background: none; border: 1px solid #e57373; border-radius: 6px; padding: 4px 8px; cursor: pointer; font-size: 14px; color: #c62828; }
    .highlight-btn { background: none; border: 1px solid #ffa726; border-radius: 6px; padding: 4px 8px; cursor: pointer; font-size: 14px; color: #e65100; }
    .highlight-btn.active { background: #fff3e0; border-color: #ff9800; color: #e65100; }
    .question.highlighted { border-color: #ff9800; background: #fff8e1; }
    h1 { text-align: center; }
  </style>
</head>
<body>
  <h1>Presenter View</h1>
  <div class="qr-section">
    <img src="<%= qrDataUrl %>" alt="QR Code">
    <p><%= origin %></p>
  </div>
  <div id="question-list" hx-get="/presenter/list" hx-trigger="every:5s, refresh from:#question-list" hx-swap="innerHTML">
    <%- include('presenter-questions', { questions }) %>
  </div>
</body>
</html>
